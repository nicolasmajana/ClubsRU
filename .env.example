# Copy this file to ".env" and fill in the real values. Never commit .env.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Discord bot token (step 3): https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional extra Gemini keys. Requests rotate between all keys that are set.
GEMINI_API_KEY_2=
# How often watcher.py re-downloads each club website, in minutes
WEB_CHECK_MINUTES=30

# 1 = return fake events without calling Gemini (saves the small free quota while building)
GEMINI_FAKE=1

# How often watcher.py checks club Instagram accounts, in seconds
WATCH_INTERVAL=60
